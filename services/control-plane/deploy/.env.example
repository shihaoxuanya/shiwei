SHIWEI_CONTROL_ORIGIN=https://zhishimanghe.com
SHIWEI_CONTROL_DB=/var/lib/shiwei-control/control.db
SHIWEI_RELEASE_REPOSITORY=shihaoxuanya/shiwei-releases
# SHA256 of a random release-publish token, not the token itself.
SHIWEI_RELEASE_TOKEN_SHA256=
# Public key ONLY. The updater private key is forbidden on this server.
SHIWEI_UPDATER_PUBLIC_KEY=
# Optional configured PostHog dashboard link, no fabricated statistics.
SHIWEI_ANALYTICS_DASHBOARD=
# Server-only random HMAC salt (32+ chars), NEVER embedded in clients or Git.
# Blank disables ingestion. Native clients do not need a secret collector token.
SHIWEI_ANALYTICS_SALT=
