[Unit]
Description=Shiwei release control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shiwei-control
Group=shiwei-control
WorkingDirectory=/opt/shiwei-control/current
EnvironmentFile=/etc/shiwei-control.env
ExecStart=/opt/shiwei-control/venv/bin/uvicorn shiwei_control.app:create_app --factory --host 127.0.0.1 --port 8920 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log --log-level warning --limit-concurrency 100 --timeout-keep-alive 5
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shiwei-control
MemoryMax=512M

[Install]
WantedBy=multi-user.target
