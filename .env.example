# Build-time public config; .env is NOT automatically loaded by Tauri signing.
SHIWEI_UPDATER_ENDPOINT=https://zhishimanghe.com/api/v1/updates/check?current_version={{current_version}}&channel=stable
SHIWEI_UPDATER_PUBLIC_KEY=placeholder
SHIWEI_ANALYTICS_HOST=https://us.i.posthog.com
SHIWEI_ANALYTICS_KEY=phc_placeholder
# Set private signing material only in a secure shell or GitHub environment Secrets.
TAURI_SIGNING_PRIVATE_KEY=placeholder
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=placeholder
# Optional Authenticode command, provided by your certificate/signing service.
SHIWEI_WINDOWS_SIGN_COMMAND=
